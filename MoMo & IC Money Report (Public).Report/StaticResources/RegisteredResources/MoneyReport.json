{
  "name": "Money Report",
  "dataColors": [
    "#1F3A5F",
    "#2A9D8F",
    "#E9A23B",
    "#C8553D",
    "#6C7A89",
    "#8AB17D",
    "#9B6A9E",
    "#4F8FC0"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#1F3A5F",
  "visualStyles": {
    "*": {
      "*": {
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E1E4E8"
              }
            },
            "radius": 6
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "border": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ]
      }
    }
  }
}