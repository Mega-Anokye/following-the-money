/// Portfolio holdings as at 16 Nov 2026 (IC statement page 1).
table Holdings
	lineageTag: aa64bf47-4094-423d-be16-1b44e1490488

	column Asset
		dataType: string
		lineageTag: 5b611bd0-8aa3-4fec-bd1f-95e7a79e7e2b
		summarizeBy: none
		sourceColumn: Asset

		annotation SummarizationSetBy = Automatic

	column Class
		dataType: string
		lineageTag: f72829f1-8100-454d-a96b-45009861be72
		summarizeBy: none
		sourceColumn: Class

		annotation SummarizationSetBy = Automatic

	column ISIN
		dataType: string
		lineageTag: 4b70e079-9ac3-4c60-85cb-06002b0e11b0
		summarizeBy: none
		sourceColumn: ISIN

		annotation SummarizationSetBy = Automatic

	column Quantity
		dataType: int64
		lineageTag: 5f4d008f-82b1-43ae-af88-bcf5178f01b9
		summarizeBy: sum
		sourceColumn: Quantity

		annotation SummarizationSetBy = Automatic

	column AvgCost
		dataType: double
		formatString: #,0.00
		lineageTag: dd0c047e-f122-4cf9-aede-e72347abfd86
		summarizeBy: none
		sourceColumn: AvgCost

		annotation SummarizationSetBy = Automatic

	column MarketPrice
		dataType: double
		formatString: #,0.00
		lineageTag: ec05fb90-8f00-463a-8726-579f6cd0131a
		summarizeBy: none
		sourceColumn: MarketPrice

		annotation SummarizationSetBy = Automatic

	column MarketValue
		dataType: double
		formatString: "GHS "#,0.00
		lineageTag: c5dd1e00-b4b5-434e-ac67-939368e7a54d
		summarizeBy: sum
		sourceColumn: MarketValue

		annotation SummarizationSetBy = Automatic

	column CostBasis
		dataType: double
		formatString: "GHS "#,0.00
		lineageTag: 99cd1cf4-50b9-4ea2-b827-ef0ef6110776
		summarizeBy: sum
		sourceColumn: CostBasis

		annotation SummarizationSetBy = Automatic

	column UnrealisedGain
		dataType: double
		formatString: "GHS "#,0.00
		lineageTag: d421dc0f-0a34-4aa5-9929-049812e609c7
		summarizeBy: sum
		sourceColumn: UnrealisedGain

		annotation SummarizationSetBy = Automatic

	partition Holdings = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "ic_holdings.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Asset", type text}, {"Class", type text}, {"ISIN", type text}, {"Quantity", Int64.Type}, {"AvgCost", type number}, {"MarketPrice", type number}, {"MarketValue", type number}, {"CostBasis", type number}, {"UnrealisedGain", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

