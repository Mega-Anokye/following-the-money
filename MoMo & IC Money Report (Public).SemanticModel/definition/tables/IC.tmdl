	partition IC = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "ic_transactions.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Account", type text}, {"No", Int64.Type}, {"Date", type date}, {"Description", type text}, {"Credit", type number}, {"Debit", type number}, {"Type", type text}, {"MatchStatus", type text}, {"MoMoTxnID", type text}, {"LagDays", Int64.Type}, {"Action", type text}, {"Ticker", type text}, {"Quantity", Int64.Type}, {"Price", type number}, {"Consideration", type number}, {"TradeCharges", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

