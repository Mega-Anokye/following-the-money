/// One row per IC Wealth transaction (ICLF and TradeLive), Jan to Nov 2026, with its matched MoMo transaction.
table IC
	lineageTag: 55ea92e0-e4ff-4108-8156-cb1e7bcb4475

	column Account
		dataType: string
		lineageTag: f8717a92-9abe-4bb5-bc85-4fc5ffbcddcb
		summarizeBy: none
		sourceColumn: Account

		annotation SummarizationSetBy = Automatic

	column No
		dataType: int64
		lineageTag: c3aab618-f123-414d-843e-381e89d22453
		summarizeBy: none
		sourceColumn: No

		annotation SummarizationSetBy = Automatic

	column Date
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: ea466250-3e55-4357-892b-138ce688fadc
